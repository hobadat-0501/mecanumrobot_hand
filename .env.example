# Jetson only. Copy to .env and adjust the server endpoint and serial device.
# Jetson address: 100.69.39.18. No inbound listener is needed on Jetson.
ROBOT_SERVER_URL=ws://100.119.83.63:8000/robot/ws
ROBOT_CONTROL_CONFIG=configs/communication.json
ROBOT_DEVICE_CONFIG=configs/devices.json
ROBOT_MOTION_ENABLED=true
ROBOT_SIMULATE=false
STM_PORT=/dev/rai_controller
STM_BAUD=115200
LIDAR_PORT=/dev/rai_lidar
LIDAR_BAUD=460800
# Leave blank to select bundled OpenNI2 SDK by architecture, or use system SDK.
CAMERA_SDK_PATH=
